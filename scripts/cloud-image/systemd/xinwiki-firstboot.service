[Unit]
Description=XinWiki first-boot initialization (runs once)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Before=xinwiki.service
ConditionPathExists=/usr/local/sbin/xinwiki-firstboot.sh
ConditionPathExists=!/opt/XinWiki/.firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xinwiki-firstboot.sh
RemainAfterExit=no
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
