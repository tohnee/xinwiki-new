# config/builtin_models.yaml — declarative built-in models.
#
# Copy to config/builtin_models.yaml (or point BUILTIN_MODELS_CONFIG at a custom
# path) to enable. Each entry below is inserted into the `models` table with
# is_builtin=true and becomes visible to every tenant.
#
# How values reach the file
# -------------------------
# Any string field can reference an env var with ${NAME}. Unset env vars are
# left as the literal ${NAME} so misconfiguration surfaces clearly in upstream
# API calls instead of producing a silent empty token. Non-string fields
# (type, source, is_default, dimension, truncate_prompt_tokens) must stay
# literal because YAML parses them as their target type.
#
# How env vars reach the container
# --------------------------------
# By default the app service in docker-compose.yml loads .env via
#   env_file:
#     - path: .env
#       required: false
# so anything you put in .env is auto-passed to the container. There is no
# need to list each var separately under `environment:`.
#
# Re-applied on every application startup — editing the file and restarting is
# enough for changes to take effect. Entries removed from the file are NOT
# auto-deleted from the database; clean them up manually if you need to.

builtin_models: []

# ----- Example: env-driven entries — uncomment and adapt --------------------
#
# builtin_models:
#   - id: builtin-llm-default
#     type: KnowledgeQA          # KnowledgeQA | Embedding | Rerank | VLLM | ASR
#     source: remote             # remote (default) | local | ...
#     is_default: true
#     name: ${LLM_MODEL_NAME}
#     parameters:
#       base_url: ${LLM_BASE_URL}
#       api_key: ${LLM_API_KEY}
#       provider: ${LLM_PROVIDER}  # openai | generic | aliyun | moonshot | ...
#
#   - id: builtin-embedding-default
#     type: Embedding
#     source: remote
#     is_default: true
#     name: ${EMBEDDING_MODEL_NAME}
#     parameters:
#       base_url: ${EMBEDDING_BASE_URL}
#       api_key: ${EMBEDDING_API_KEY}
#       provider: ${EMBEDDING_PROVIDER}
#       embedding_parameters:
#         dimension: 1536
#         truncate_prompt_tokens: 0
#
#   - id: builtin-rerank-default
#     type: Rerank
#     source: remote
#     parameters:
#       base_url: ${RERANK_BASE_URL}
#       api_key: ${RERANK_API_KEY}
#       provider: ${RERANK_PROVIDER}
#
# ----- Example: literal values (no env indirection) -------------------------
#
# builtin_models:
#   - id: builtin-openai-chat
#     name: gpt-4o-mini
#     type: KnowledgeQA
#     source: remote
#     is_default: false
#     parameters:
#       base_url: https://api.openai.com/v1
#       api_key: ${OPENAI_API_KEY}
#       provider: openai
#
# ----- Pricing example (USD per 1,000,000 tokens) ---------------------------
#
# `input_price_per_million` / `output_price_per_million` / `cached_input_price_per_million`
# are optional but recommended for any model you actually use for chat / RAG.
# When left at zero the cost dashboard silently reports $0 for calls to the
# model, and CalculateCost returns 0 — so agent runs go uncosted even when a
# real upstream bill is being racked up. Re-applied on every startup, so editing
# the YAML + restart reconciles price changes on an existing row.
#
# OpenAI / DeepSeek / Azure / etc. treat the cached portion of prompt_tokens
# as a SUBSET of the prompt and bill it at cached_input_price_per_million.
# Leave the field at zero for those providers to fall back to the full input
# rate (i.e. no discount).
#
# Anthropic uses ADDITIVE cache billing: cache_read and cache_creation tokens
# are reported as SEPARATE events, additive to input_tokens, and billed at
# distinct rates (~0.1x input for cache_read, ~1.25x input for cache_creation).
# The loader's default for cached_input_price_per_million=0 maps to a 0.1x
# ratio for Anthropic cache_read. For non-Anthropic providers 0 means "fall
# back to no discount" instead, so set it explicitly when OpenAI-style caching
# applies.
#
# builtin_models:
#   - id: builtin-openai-chat
#     name: gpt-4o
#     type: KnowledgeQA
#     source: remote
#     parameters:
#       base_url: https://api.openai.com/v1
#       api_key: ${OPENAI_API_KEY}
#       provider: openai
#     input_price_per_million: 2.5
#     output_price_per_million: 10.0
#     cached_input_price_per_million: 1.25   # OpenAI prompt-cache: 50% discount
#   - id: builtin-anthropic-sonnet
#     name: claude-3-5-sonnet-20241022
#     type: KnowledgeQA
#     source: remote
#     parameters:
#       base_url: https://api.anthropic.com
#       api_key: ${ANTHROPIC_API_KEY}
#       provider: anthropic
#     input_price_per_million: 3.0
#     output_price_per_million: 15.0
#     # Anthropic: leaving this at 0 falls back to the published 0.1x ratio
#     # — cache_creation is always priced at 1.25x input_price_per_million.
#     cached_input_price_per_million: 0.3
